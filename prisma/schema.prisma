// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS - Gestion des comptes utilisateurs
// Rôles : user_free, user_premium, admin
// ============================================================
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  passwordHash     String? // null si auth Google uniquement
  image            String?
  role             String    @default("user_free") // 'user_free' | 'user_premium' | 'admin'
  stripeCustomerId String? // ID client Stripe pour les abonnements
  suspended        Boolean   @default(false) // Compte suspendu par l'admin
  emailVerified    DateTime? // null = not verified
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  transactions Transaction[]
  accounts     Account[]
  sessions     Session[]
}

// ============================================================
// NextAuth - Models requis pour l'authentification
// ============================================================
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// TOKENS - Crypto-actifs supportés par la plateforme
// Géré par l'admin + API externe (CoinGecko/CryptoCompare)
// ============================================================
model Token {
  id              String    @id @default(cuid())
  ticker          String    @unique // ex: BTC, ETH, SOL, TAO
  name            String // ex: Bitcoin, Ethereum
  coingeckoId     String? // ID CoinGecko pour le rafraîchissement automatique
  cryptoCompareId String? // ID CryptoCompare (alternative)
  currentPrice    Float? // Prix actuel en USD (mis à jour par cron)
  priceUpdatedAt  DateTime? // Dernière mise à jour du prix
  active          Boolean   @default(true) // Token actif/inactif
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  transactions Transaction[]
}

// ============================================================
// EXCHANGES - Plateformes d'échange supportées
// Géré par l'admin
// ============================================================
model Exchange {
  id        String   @id @default(cuid())
  name      String   @unique // ex: BINANCE, BYBIT, COINBASE
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  transactions Transaction[]
}

// ============================================================
// TRANSACTIONS - Historique des achats crypto
// Basé sur l'onglet BDD du fichier Excel
// ============================================================
model Transaction {
  id             String   @id @default(cuid())
  userId         String // Propriétaire de la transaction
  date           DateTime // Date de l'achat
  tokenTicker    String // ex: BTC, ETH (dénormalisé pour faciliter les requêtes)
  montantInvesti Float // Montant investi en USD (ex: 15.70)
  coursAchat     Float // Prix du token au moment de l'achat (ex: 82603.9)
  quantite       Float // Quantité achetée = montantInvesti / coursAchat
  exchangeId     String? // Plateforme d'échange (optionnel)
  notes          String? // Notes optionnelles
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token    Token     @relation(fields: [tokenTicker], references: [ticker], onDelete: Restrict)
  exchange Exchange? @relation(fields: [exchangeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tokenTicker])
  @@index([userId, tokenTicker])
}
