    "html": "<html lang=\"fr\" class=\"dark\"><head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Accueil — Vidéos Privées Crypto</title>\n  <meta name=\"robots\" content=\"noindex,nofollow\">\n  <link rel=\"icon\" type=\"image/svg+xml\" href=\"/service-video/gateway/public/favicon.svg\">\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n  <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400&amp;display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"/service-video/gateway/public/css/app.css?v=1780483602\">\n      <link rel=\"stylesheet\" href=\"/service-video/gateway/public/css/landing.css?v=1780483602\">\n    <script>\n    const BASE = '/service-video/gateway';\n    const THEME = 'dark';\n    const CSRF_TOKEN = '5c7e5937c74ae01a61d2e6bad838101b30fc8777ed684ad7c84d34d47e26bf45';\n  </script>\n    <script src=\"/service-video/gateway/public/js/consent.js?v=1780483603\"></script>\n  </head>\n<body>\n\n<!-- ── SVG filter — avatar electric frame (rendered once, referenced everywhere) ── -->\n<svg width=\"0\" height=\"0\" style=\"position:absolute;pointer-events:none;overflow:hidden\" aria-hidden=\"true\" focusable=\"false\">\n  <defs>\n    <filter id=\"elec-distort\" color-interpolation-filters=\"sRGB\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n      <feTurbulence type=\"turbulence\" baseFrequency=\"0.05\" numOctaves=\"6\" result=\"noise1\" seed=\"1\"></feTurbulence>\n      <feOffset in=\"noise1\" dx=\"0\" dy=\"0\" result=\"offsetNoise1\">\n        <animate attributeName=\"dy\" values=\"150; 0\" dur=\"6s\" repeatCount=\"indefinite\" calcMode=\"linear\"></animate>\n      </feOffset>\n      <feTurbulence type=\"turbulence\" baseFrequency=\"0.05\" numOctaves=\"6\" result=\"noise2\" seed=\"1\"></feTurbulence>\n      <feOffset in=\"noise2\" dx=\"0\" dy=\"0\" result=\"offsetNoise2\">\n        <animate attributeName=\"dy\" values=\"0; -150\" dur=\"6s\" repeatCount=\"indefinite\" calcMode=\"linear\"></animate>\n      </feOffset>\n      <feTurbulence type=\"turbulence\" baseFrequency=\"0.05\" numOctaves=\"6\" result=\"noise3\" seed=\"2\"></feTurbulence>\n      <feOffset in=\"noise3\" dx=\"0\" dy=\"0\" result=\"offsetNoise3\">\n        <animate attributeName=\"dx\" values=\"120; 0\" dur=\"6s\" repeatCount=\"indefinite\" calcMode=\"linear\"></animate>\n      </feOffset>\n      <feTurbulence type=\"turbulence\" baseFrequency=\"0.05\" numOctaves=\"6\" result=\"noise4\" seed=\"2\"></feTurbulence>\n      <feOffset in=\"noise4\" dx=\"0\" dy=\"0\" result=\"offsetNoise4\">\n        <animate attributeName=\"dx\" values=\"0; -120\" dur=\"6s\" repeatCount=\"indefinite\" calcMode=\"linear\"></animate>\n      </feOffset>\n      <feComposite in=\"offsetNoise1\" in2=\"offsetNoise2\" result=\"part1\"></feComposite>\n      <feComposite in=\"offsetNoise3\" in2=\"offsetNoise4\" result=\"part2\"></feComposite>\n      <feBlend in=\"part1\" in2=\"part2\" mode=\"color-dodge\" result=\"combinedNoise\"></feBlend>\n      <feDisplacementMap in=\"SourceGraphic\" in2=\"combinedNoise\" scale=\"6\" xChannelSelector=\"R\" yChannelSelector=\"B\"></feDisplacementMap>\n    </filter>\n  </defs>\n</svg>\n\n\n<!-- ═══ CANVAS PARTICULES ═══════════════════════════════════ -->\n<canvas id=\"lp-canvas\" aria-hidden=\"true\" width=\"1280\" height=\"1280\" style=\"width: 1280px; height: 1280px;\"></canvas>\n\n<!-- ═══ ORBES DE FOND ════════════════════════════════════════ -->\n<div class=\"lp-orb lp-orb-1\" aria-hidden=\"true\"></div>\n<div class=\"lp-orb lp-orb-2\" aria-hidden=\"true\"></div>\n<div class=\"lp-orb lp-orb-3\" aria-hidden=\"true\"></div>\n\n<div class=\"page-landing\" id=\"lp-root\">\n\n  <!-- ══ NAV ══════════════════════════════════════════════════ -->\n  <nav class=\"lp-nav\" id=\"lp-nav\">\n    <div class=\"lp-nav-inner\">\n      <div class=\"lp-logo\"><span class=\"gtext\">LexaMoon</span></div>\n      <div class=\"lp-nav-links\">\n        <a href=\"#lp-features\" class=\"lp-nav-link\">Fonctionnalités</a>\n        <a href=\"#lp-steps\" class=\"lp-nav-link\">Comment ça marche</a>\n        <a href=\"#lp-tournament\" class=\"lp-nav-link\">Tournois</a>\n      </div>\n      <div class=\"lp-nav-actions\">\n        <a href=\"/service-video/gateway/login\" class=\"btn btn-ghost btn-sm\">Connexion</a>\n        <a href=\"/service-video/gateway/register\" class=\"btn btn-gold  btn-sm lp-shimmer-btn\" data-magnetic=\"0.2\">\n          Rejoindre\n          <span class=\"lp-shimmer\" aria-hidden=\"true\"></span>\n        </a>\n      </div>\n    </div>\n  </nav>\n\n  \n  <!-- ══ HERO ══════════════════════════════════════════════════ -->\n  <section class=\"lp-hero\">\n    <div class=\"lp-hero-inner\">\n\n      <!-- Colonne texte -->\n      <div class=\"lp-hero-copy\">\n\n        <div class=\"lp-eyebrow lp-anim lp-visible\" data-delay=\"0\">\n          <span class=\"lp-eyebrow-dot\"></span>\n          Accès membres exclusifs\n        </div>\n\n        <h1 class=\"lp-h1 lp-anim lp-visible\" data-delay=\"80\">\n          VIDÉOS PRIVÉES<br>\n          <span class=\"gtext\">Lexa Moon</span>\n        </h1>\n\n        <p class=\"lp-sub lp-anim lp-visible\" data-delay=\"180\">\n          Analyses vidéo privées sur les marchés crypto —\n          réservées aux membres qui veulent une longueur d'avance.\n        </p>\n\n        <div class=\"lp-hero-actions lp-anim lp-visible\" data-delay=\"260\">\n          <a href=\"/service-video/gateway/register\" class=\"btn btn-gold btn-xl lp-shimmer-btn lp-cta-main\" data-magnetic=\"0.22\">\n            <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><line x1=\"19\" y1=\"8\" x2=\"19\" y2=\"14\"></line><line x1=\"22\" y1=\"11\" x2=\"16\" y2=\"11\"></line></svg>\n            Créez votre compte\n            <span class=\"lp-shimmer\" aria-hidden=\"true\"></span>\n          </a>\n          <a href=\"/service-video/gateway/login\" class=\"btn btn-ghost btn-xl\" data-magnetic=\"0.18\">Se connecter</a>\n        </div>\n\n        <!-- Trust pills -->\n        <div class=\"lp-trust-pills lp-anim lp-visible\" data-delay=\"340\">\n          <span class=\"lp-trust-pill\">\n            <svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path></svg>\n            Paiement sécurisé Stripe\n          </span>\n          <span class=\"lp-trust-pill\">\n            <svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"></line><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"></line></svg>\n            Résiliable à tout moment\n          </span>\n          <span class=\"lp-trust-pill\">\n            <svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polygon points=\"23 7 16 12 23 17 23 7\"></polygon><rect x=\"1\" y=\"5\" width=\"15\" height=\"14\" rx=\"2\"></rect></svg>\n            Vidéos privées 7j/7\n          </span>\n        </div>\n\n      </div><!-- /hero-copy -->\n\n      <!-- Colonne visuelle flottante -->\n      <div class=\"lp-hero-visual lp-anim lp-visible\" data-delay=\"150\" id=\"lp-parallax-root\" aria-hidden=\"true\">\n\n        <!-- Carte vidéo avec chart trading en fond -->\n        <div class=\"lp-card lp-card-video\" data-tilt=\"6\">\n          <div class=\"lp-card-video-thumb\">\n            <div class=\"lp-card-video-glow\"></div>\n\n            <!-- Graphique de trading en fond -->\n            <svg class=\"lp-vide