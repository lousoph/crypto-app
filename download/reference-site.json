ideo-price\">\n              <span class=\"lp-cv-symbol\">BTC/USDT</span>\n              <span class=\"lp-cv-change\">+4.82%</span>\n            </div>\n\n            <!-- Bouton play au centre -->\n            <div class=\"lp-card-video-play\" aria-hidden=\"true\">\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><polygon points=\"5 3 19 12 5 21 5 3\"></polygon></svg>\n            </div>\n            <div class=\"lp-card-video-badge\">🔒 Membres</div>\n          </div>\n          <div class=\"lp-card-video-meta\">\n            <div class=\"lp-card-video-title\">Analyse BTC/USDT · Semaine 42</div>\n            <div class=\"lp-card-video-sub\">Nouvelle vidéo disponible</div>\n          </div>\n        </div>\n\n        <!-- Carte ticker -->\n        <div class=\"lp-card lp-card-ticker\" data-tilt=\"8\">\n          <div class=\"lp-card-ticker-hd\">\n            <span class=\"lp-ticker-live-dot\"></span>\n            Watchlist live\n          </div>\n          <div class=\"lp-ticker-row\" style=\"display:flex;align-items:center;gap:.4rem;padding:6px 0;border-bottom:1px solid rgba(255,255,255,.07)\">\n            <span class=\"lp-ticker-sym\" style=\"font-size:12px;font-weight:800;color:#fff;width:30px;flex-shrink:0\">BTC</span>\n            <span class=\"lp-ticker-price\" id=\"lp-btc-price\" style=\"flex:1;font-size:11px;font-weight:700;color:rgba(255,255,255,.65);white-space:nowrap\">$62,038</span>\n            <span class=\"lp-ticker-pct\" id=\"lp-btc\" style=\"font-size:11px;font-weight:800;color:#4ade80;background:rgba(74,222,128,.12);padding:2px 6px;border-radius:6px;flex-shrink:0\">+4.82%</span>\n          </div>\n          <div class=\"lp-ticker-row\" style=\"display:flex;align-items:center;gap:.4rem;padding:6px 0;border-bottom:1px solid rgba(255,255,255,.07)\">\n            <span class=\"lp-ticker-sym\" style=\"font-size:12px;font-weight:800;color:#fff;width:30px;flex-shrink:0\">ETH</span>\n            <span class=\"lp-t