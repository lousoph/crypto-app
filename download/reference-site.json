=\"125\" stroke=\"#4ade80\" stroke-width=\"1\"></line>\n                  <rect x=\"42\" y=\"100\" width=\"8\" height=\"20\" fill=\"#4ade80\"></rect>\n                </g>\n                <g class=\"lp-vc-candle\" style=\"--d:.20s\">\n                  <line x1=\"62\" y1=\"92\" x2=\"62\" y2=\"115\" stroke=\"#4ade80\" stroke-width=\"1\"></line>\n                  <rect x=\"58\" y=\"95\" width=\"8\" height=\"16\" fill=\"#4ade80\"></rect>\n                </g>\n                <g class=\"lp-vc-candle\" style=\"--d:.25s\">\n                  <line x1=\"78\" y1=\"88\" x2=\"78\" y2=\"110\" stroke=\"#f87171\" stroke-width=\"1\"></line>\n                  <rect x=\"74\" y=\"90\" width=\"8\" height=\"18\" fill=\"#f87171\"></rect>\n                </g>\n                <g class=\"lp-vc-candle\" style=\"--d:.30s\">\n                  <line x1=\"94\" y1=\"78\" x2=\"94\" y2=\"105\" stroke=\"#4ade80\" stroke-width=\"1\"></line>\n                  <rect x=\"90\" y=\"82\" width=\"8\" height=\"20\" fill=\"#4ade80\"></rect>\n                </g>\n                <g class=\"lp-vc-candle\" style=\"--d:.35s\">\n                  <line x1=\"110\" y1=\"70\" x2=\"110\" y2=\"95\" stroke=\"#4ade80\" stroke-width=\"1\"></line>\n                  <rect x=\"106\" y=\"72\" width=\"8\" height=\"20\" fill=\"#4ade80\"></rect>\n                </g>\n                <g class=\"lp-vc-candle\" style=\"--d:.40s\">\n                  <line x1=\"126\" y1=\"68\" x2=\"126\" y2=\"88\" stroke=\"#f87171\" stroke-width=\"1\"></line>\n                  <rect x=\"122\" y=\"72\" width=\"8\" height=\"13\" fill=\"#f87171\"></rect>\n                </g>\n                <g class=\"lp-vc-candle\" style=\"--d:.45s\">\n                  <line x1=\"142\" y1=\"58\" x2=\"142\" y2=\"85\" stroke=\"#4ade80\" stroke-width=\"1\"></line>\n                  <rect x=\"138\" y=\"62\" width=\"8\" height=\"20\" fill=\"#4ade80\"></rect>\n                </g>\n                <g class=\"lp-vc-candle\" style=\"--d:.50s\">\n                  <line x1=\"158\" y1=\"52\" x2=\"158\" y2=\"75\" stroke=\"#4ade80\" stroke-width=\"1\"></line>\n                  <rect x=\"154\" y=\"54\" width=\"8\" height=\"18\" fill=\"#4ade80\"></rect>\n                </g>\n                <g class=\"lp-vc-candle\" style=\"--d:.55s\">\n                  <line x1=\"174\" y1=\"48\" x2=\"174\" y2=\"68\" stroke=\"#f87171\" stroke-width=\"1\"></line>\n                  <rect x=\"170\" y=\"52\" width=\"8\" height=\"13\" fill=\"#f87171\"></rect>\n                </g>\n                <g class=\"lp-vc-candle\" style=\"--d:.60s\">\n                  <line x1=\"190\" y1=\"40\" x2=\"190\" y2=\"65\" stroke=\"#4ade80\" stroke-width=\"1\"></line>\n                  <rect x=\"186\" y=\"44\" width=\"8\" height=\"18\" fill=\"#4ade80\"></rect>\n                </g>\n                <g class=\"lp-vc-candle\" style=\"--d:.65s\">\n                  <line x1=\"206\" y1=\"34\" x2=\"206\" y2=\"58\" stroke=\"#4ade80\" stroke-width=\"1\"></line>\n                  <rect x=\"202\" y=\"36\" width=\"8\" height=\"20\" fill=\"#4ade80\"></rect>\n                </g>\n                <g class=\"lp-vc-candle\" style=\"--d:.70s\">\n                  <line x1=\"222\" y1=\"32\" x2=\"222\" y2=\"52\" stroke=\"#f87171\" stroke-width=\"1\"></line>\n                  <rect x=\"218\" y=\"36\" width=\"8\" height=\"12\" fill=\"#f87171\"></rect>\n                </g>\n                <g class=\"lp-vc-candle\" style=\"--d:.75s\">\n                  <line x1=\"238\" y1=\"26\" x2=\"238\" y2=\"48\" stroke=\"#4ade80\" stroke-width=\"1\"></line>\n                  <rect x=\"234\" y=\"30\" width=\"8\" height=\"15\" fill=\"#4ade80\"></rect>\n                </g>\n                <g class=\"lp-vc-candle\" style=\"--d:.80s\">\n                  <line x1=\"254\" y1=\"22\" x2=\"254\" y2=\"42\" stroke=\"#4ade80\" stroke-width=\"1\"></line>\n                  <rect x=\"250\" y=\"24\" width=\"8\" height=\"16\" fill=\"#4ade80\"></rect>\n                </g>\n                <g class